# --- Telephony (Twilio Elastic SIP Trunk -> LiveKit SIP) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- STT ---
DEEPGRAM_API_KEY=

# --- LLM (OpenAI-compatible; Groq / Cerebras / Fireworks) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen-3-235b-a22b-instruct

# Temperature stays at 0: the gas-leak override has to come out verbatim.
# Repetition is handled with a frequency penalty instead, which discourages
# reused tokens without loosening the model's grip on scripted lines.
LLM_TEMPERATURE=0.0
LLM_FREQUENCY_PENALTY=0.3

# Time to first token before cascading to the backup. Set a fallback before
# taking real traffic -- without one, a rate-limited primary is a ten-second
# hole in the call rather than a slightly worse answer.
LLM_TIMEOUT_S=4.0
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=

# --- TTS ---
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# --- Post-call delivery ---
# Without these the agent's closing promise -- that someone gets the caller's
# details the moment the call ends -- is not kept. The worker logs a warning
# on every call until they are set.
DANA_WEBHOOK_URL=
DANA_WEBHOOK_SECRET=

# --- Runtime ---
DANA_TENANT_DIR=src/dana/tenants/data
DANA_DATA_DIR=data
DANA_TRACE_DIR=data/traces
DANA_LOG_LEVEL=INFO

# --- Evals (scripts/eval_calls.py) ---
# The judge should be the strongest model available and does not need to be
# fast. Point it somewhere other than LLM_MODEL: grading a model's output with
# the same model is self-marking.
EVAL_BASE_URL=https://api.groq.com/openai/v1
EVAL_API_KEY=
EVAL_MODEL=
