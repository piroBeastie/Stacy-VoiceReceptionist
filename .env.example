# --- Telephony (Twilio Elastic SIP Trunk -> LiveKit SIP) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- STT ---
DEEPGRAM_API_KEY=

# --- LLM ---
# Two separate decisions live here. The HOST sets time to first token: the same
# open weights on Groq or Cerebras versus a general cloud is roughly 150ms
# against 500ms, and first-token time is the only LLM number a caller can hear.
# The MODEL sets whether the answer is right.
#
# The default is a frontier model, not the fastest host, because on this
# workload a wrong answer is not a slower call -- it is a technician sent to the
# wrong address, or a price quoted that the business will not honour. The half
# second is bought back elsewhere: preemptive generation starts the turn on the
# interim transcript, the prompt prefix is cached, and a filler covers the gap
# before a tool call. None of those recover a mistake.
#
# scripts/eval_calls.py is what settles this rather than argument.
LLM_VENDOR=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_API_KEY=
LLM_BASE_URL=

# The system prompt is ~5,700 tokens of tenant knowledge and 99.2% of it is
# byte-identical between turns. OpenAI-compatible hosts cache it automatically;
# Anthropic only caches when asked. Leave this on.
LLM_CACHING=1

# Strict tool schemas. Leave off: the API compiles a grammar per request,
# measured at about 3.5s added to every generation (809ms off, 3762ms on).
LLM_STRICT_TOOLS=0

# Empty means "do not send temperature", which is NOT the same as sending 0.
# The newest Anthropic models reject the parameter with a 400 marked
# non-retryable, so sending it fails every turn instantly rather than degrading.
# It was pinned to 0 so the gas-leak script came out verbatim; that reason is
# gone, because dana.agent.safety intercepts gas and CO before inference and the
# one line that cannot slip no longer depends on sampling at all.
# OpenAI-compatible hosts still accept it -- see LLM_FALLBACK_TEMPERATURE.
LLM_TEMPERATURE=
# OpenAI-compatible hosts only -- the Anthropic API has no such parameter.
LLM_FREQUENCY_PENALTY=0.3

# Time to first token before cascading to the backup. This is where a fast
# open-weight model earns its place: once the smart primary has timed out, the
# comparison is no longer "smart versus fast", it is "fast versus dead air".
# The fallback is a different vendor on a different account, so it names its own
# key variable -- sharing one silently sent it the primary's credential.
LLM_TIMEOUT_S=4.0
LLM_FALLBACK_VENDOR=openai
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_TEMPERATURE=0.0
LLM_FALLBACK_API_KEY=

# --- TTS ---
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# --- Post-call delivery ---
# Without these the agent's closing promise -- that someone gets the caller's
# details the moment the call ends -- is not kept. The worker logs a warning
# on every call until they are set.
DANA_WEBHOOK_URL=
DANA_WEBHOOK_SECRET=

# --- Runtime ---
DANA_TENANT_DIR=src/dana/tenants/data

# Which tenant answers when there is no dialed number to route on. That is
# `console` and `dev` mode, which have no SIP attributes at all -- without this,
# the fastest way to hear the agent raises KeyError before it says a word.
# On a live trunk the dialed number always wins, and this firing is logged as a
# warning because it means the SIP attribute name has moved.
DANA_DEFAULT_TENANT=millbrook
DANA_DATA_DIR=data
DANA_TRACE_DIR=data/traces
DANA_LOG_LEVEL=INFO

# Name the worker to make LiveKit dispatch explicit: it then joins only rooms
# whose dispatch rule names it, instead of every room in the project. Leave it
# unset for one agent in one project. If you set it, re-run scripts/sip_config.py
# -- the rule reads the same variable, and a mismatch is a call that connects
# and sits in silence because nobody joined.
DANA_AGENT_NAME=

# --- Evals (scripts/eval_calls.py) ---
# The judge should be the strongest model available and does not need to be
# fast. Point it somewhere other than LLM_MODEL: grading a model's output with
# the same model is self-marking.
EVAL_BASE_URL=https://api.groq.com/openai/v1
EVAL_API_KEY=
EVAL_MODEL=
